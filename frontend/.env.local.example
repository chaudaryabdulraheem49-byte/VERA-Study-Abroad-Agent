# Where the FastAPI backend is reachable from the Next.js server
BACKEND_URL=http://127.0.0.1:8000

# --- Accounts (optional) ---------------------------------------------------
# Leave blank and the app runs without accounts. Both values are public by
# design: the anon key carries no privileges and is governed entirely by Row
# Level Security. The service-role key belongs in backend/.env, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
