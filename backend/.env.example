# EXAMPLE FILE - copy to .env, do not overwrite an existing one:
#     cp -n .env.example .env
# .env holds the live API key and is gitignored, so clobbering it loses
# the key. The app then falls back to scripted replies with no error;
# GET /api/health shows "llm_configured": false when that has happened.

# --- LLM --------------------------------------------------------------------
# openai | gemini  (Gemini is reached via its OpenAI-compatible endpoint)
LLM_PROVIDER=gemini

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Blank = the default for the active provider.
#   gemini -> gemini-3.6-flash / gemini-3.6-flash / gemini-3.1-flash-lite
#   openai -> gpt-4o / gpt-4o / gpt-4o-mini
# Keep CHAT_MODEL and EXTRACTION_MODEL on different models for Gemini: the free
# tier meters requests per minute per model (5 RPM), and each turn makes two
# calls. Splitting them across models keeps a normal conversation under the cap.
CHAT_MODEL=
VISION_MODEL=
EXTRACTION_MODEL=

# --- Document parsing -------------------------------------------------------
# vision (uses VISION_MODEL) or llamaparse
OCR_PROVIDER=vision
# LLAMAPARSE_API_KEY=llx-...
OCR_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=10485760

# --- Sessions ---------------------------------------------------------------
# Unset -> in-process memory (single worker only)
# REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Phase 2: crawl, ingest, hybrid search ---------------------------------
# `docker compose up -d` from the repo root starts both of these.
# Host port 5433: a native PostgreSQL service commonly owns 5432 already,
# and both binding it shows up as a password failure rather than a conflict.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/study_abroad
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=course_syllabi

# Blank = the provider default.
#   gemini -> gemini-3.1-flash-lite / gemini-embedding-001    (1536 dims)
#   openai -> gpt-4o-mini           / text-embedding-3-small  (1536 dims)
# EMBEDDING_DIMENSIONS must match the Qdrant collection: changing the
# embedding model means recreating the collection.
CRAWLER_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

CRAWL_TIMEOUT_SECONDS=120
CRAWL_MAX_RETRIES=3
# Enough to cover a whole country's catalogue in one pass. Candidates are
# taken cheapest-first, so a low cap silently hides every expensive
# programme from the search rather than merely trimming the list.
MAX_SQL_CANDIDATES=4000
SEARCH_TOP_K=10


# --- Accounts (optional) ---------------------------------------------------
# Leave blank and the app runs without accounts, exactly as it did before them.
# Fill these in and chat routes require a signed-in user and save history.
#
# Project settings -> API
SUPABASE_URL=
# Project settings -> API -> Service role key. Server only: it bypasses Row
# Level Security and must never reach a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project settings -> API -> JWT secret (legacy HS256 projects). Projects on
# asymmetric keys need no secret - the public JWKS is fetched instead.
SUPABASE_JWT_SECRET=
# Only if the JWKS lives somewhere other than <url>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
